# Copy to .env (gitignored) and fill in. docker compose reads it automatically.

# Hugging Face token, read access. Needed by gigaam.vad_utils.get_pipeline to
# download pyannote/segmentation-3.0 the first time (cached in the hf-cache
# volume after that).
#   1. accept the terms at https://huggingface.co/pyannote/segmentation-3.0
#   2. create a read token at https://huggingface.co/settings/tokens
HF_TOKEN=

# Host directory mounted at /models: the diarization pipeline (read on the
# first mono request) and the gender CNN (read only when a request asks for
# gender). Defaults to this checkout's model_weights/; point it elsewhere to
# serve weights from a shared volume instead. Interpolated by compose, so set
# it in stack/.env rather than here.
# MODEL_WEIGHTS_DIR=

# --- model / decoding -------------------------------------------------------
# ASR_MODEL=multilingual_large_ctc
# DECODER=beam          # beam (hotword CTC beam search) | greedy
# (DEVICE is set by the compose file from ASR_DEVICE in stack/.env)
# FP16=1                 # fp16 encoder weights, ~4x less VRAM
# GENDER_WEIGHTS=        # the weights file itself, overriding the /models path

# --- diarization (mono input only, see src/diarization.py) ---------------
# DIARIZE_MONO=1
# DIARIZATION_MIN_SPEAKERS=   # unset = let pyannote decide
# DIARIZATION_MAX_SPEAKERS=

# --- server ------------------------------------------------------------
# PORT=8400
# WORKERS=1
# MAX_PAYLOAD_MB=512

# --- LLM normalisation (see src/normalize.py) ------------------------------
# LLM_BASE_URL / LLM_API_KEY / LLM_MODEL / LLM_INTERNAL_HOSTS are set by the
# compose file to the in-stack LiteLLM gateway and override anything here.
# RUN_LLM=1             # default for requests that do not send run_llm
# LLM_ALLOW_EXTERNAL=0  # required if LLM_BASE_URL is neither loopback nor in
                        # LLM_INTERNAL_HOSTS -- PII masking is not in this
                        # build, so a non-local endpoint receives the raw
                        # transcript

# --- consumed by client.py / deploy/verify.py, not by the container itself
# ASR_SERVICE_URL=http://127.0.0.1:8400/analyze
