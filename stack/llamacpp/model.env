# The "plug in a model" file. Any llama-server flag can be set here through its
# LLAMA_ARG_* env var. Pick ONE model source.

# (a) local GGUF from ~/.models (mounted at /models)
LLAMA_ARG_MODEL=/models/Qwen3-8B-Q4_K_M.gguf

# (b) or auto-download from Hugging Face (cached in the llamacpp-cache volume):
# LLAMA_ARG_HF_REPO=unsloth/Qwen3-8B-GGUF:Q4_K_M

LLAMA_ARG_CTX_SIZE=16384
# 0 = CPU-only; raise for GPU (needs LLAMACPP_IMAGE_TAG=server-cuda). 8GB VRAM
# fits few layers of a 27B model -- tune.
LLAMA_ARG_N_GPU_LAYERS=999
LLAMA_ARG_JINJA=1
