# docker compose reads this file automatically for any `docker compose`
# command run from this directory -- no extra flags needed.
#
# GPU attachments are opt-in overrides, colon-separated. The LLM gets the GPU
# by default; to give it to ASR too, append :overrides/asr-gpu.override.yml
# (and set ASR_DEVICE=cuda) -- mind the 8 GB VRAM budget.
COMPOSE_FILE=compose.yml:overrides/llamacpp-gpu.override.yml

# "server" (CPU) or "server-cuda"
LLAMACPP_IMAGE_TAG=server-cuda

# Secrets are appended below by `sh secrets/gen.sh >> .env`: LITELLM_MASTER_KEY
# (LiteLLM's master key, also the bearer the ASR service sends) and Langfuse's
# NEXTAUTH_SECRET, SALT, ENCRYPTION_KEY, PROJECT_PUBLIC_KEY, PROJECT_SECRET_KEY,
# USER_PASSWORD, all interpolated into overrides/*.yml.
